# ResTrack — Environment Variables
# Copy this file to .env.local for local development
# Set these in Vercel dashboard for production

# Optional: Lock to a single Jira workspace server-side
# (if not set, users enter their own credentials in the UI)
# JIRA_URL=https://yourteam.atlassian.net
# JIRA_EMAIL=admin@yourcompany.com
# JIRA_API_TOKEN=your_api_token_here
